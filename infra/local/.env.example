# ============================================================================
# TRÍADE — máquina dedicada: ajustes SÓ desta máquina (modelo)
#
#   cp infra/local/.env.example infra/local/.env
#
# `infra/local/.env` é gitignored e NÃO guarda segredo nenhum: só perfis, portas,
# limites de memória e nomes de arquivo. Se você está prestes a colar uma chave aqui,
# parou no arquivo errado.
#
# ONDE CADA COISA MORA
#   · Segredos da operação (Supabase, Meta/WhatsApp, Anthropic, HMAC da Komune)
#     → `.env` na RAIZ do repositório (modelo em `.env.example` da raiz). É esse
#       arquivo que os três workers leem; sem ele o `docker compose up` falha na hora.
#   · Token do Cloudflare Tunnel (se e só se você ligar o perfil `tunel`)
#     → `infra/local/.env.cloudflared`, um arquivo só dele, também gitignored, para o token
#       não vazar para os outros contêineres pelo `.env` compartilhado. Crie com uma linha só:
#         printf 'TUNNEL_TOKEN=cole-o-token-aqui\n' > infra/local/.env.cloudflared
#       O token sai de Cloudflare Zero Trust → Networks → Tunnels → "Install connector"
#       (a string depois de `--token`). É senha: trate como senha. E ponha o Cloudflare Access
#       na frente do hostname antes de ligar, senão o painel do CRM fica público na internet.
#       (Não há `.env.cloudflared.example` neste repositório de propósito: o `.gitignore` ignora
#       tudo que começa com `.env.`, e um modelo que o git não versiona não serviria de modelo.)
#   · Segredos das Edge Functions → Supabase → Edge Functions → Secrets. Não passam por aqui.
#
# Passo a passo do zero: docs/operacao/maquina-do-luiz.md
# ============================================================================

# ---------------------------------------------------------------------------
# O que sobe com `docker compose up -d`
# ---------------------------------------------------------------------------
# Perfis separados por vírgula. Sem nada: só metabase e faster-whisper.
#   workers       os três workers (ingest, wa, ai) — é o que a máquina dedicada existe para rodar
#   rotas         osrm (exige o grafo já preparado em ./data/osrm)
#   osrm-preparo  tarefa única que constrói o grafo; não deixe ligado no dia a dia
#   tunel         cloudflared (só se o Metabase precisar sair do tailnet)
# Na máquina do Luiz, em operação normal: workers,rotas
COMPOSE_PROFILES=workers

# ---------------------------------------------------------------------------
# Metabase
# ---------------------------------------------------------------------------
# Porta no HOST, sempre presa em 127.0.0.1 (o compose fixa o endereço; aqui só o número).
# De fora chega-se por `tailscale serve --bg 3001`, nunca por porta aberta no roteador.
METABASE_PORT=3001

# ---------------------------------------------------------------------------
# Workers — identidade e healthcheck
# ---------------------------------------------------------------------------
# Nome desta instância na tabela `worker_heartbeats` (a chave é worker + instance).
# Uma máquina dedicada = "default". Só mude se um dia houver duas máquinas.
WORKER_INSTANCE=default
# Idade máxima da última batida de ponto antes de o contêiner virar "unhealthy", em segundos.
# 600 é o mesmo limite do alerta do RF-ADM-07 ("worker calado há mais de 10 min").
WORKER_HEARTBEAT_MAX_AGE_S=600
# Quanto o healthcheck espera pela resposta do Supabase, em milissegundos.
WORKER_HEALTHCHECK_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# Limites de memória por contêiner (aceita 512m, 2g, ...)
# Somados, os padrões abaixo dão ~9,3 GB de TETO (não de uso: em repouso os seis contêineres
# ficam bem abaixo disso). Foram calculados para uma máquina de 16 GB com o perfil `rotas` ligado.
# Numa de 8 GB, baixe MEM_WHISPER para 2g, MEM_METABASE para 1g e MEM_WORKER_INGEST para 1g.
# O `osrm-preparo` é tarefa única e não conta: ele roda sozinho, uma vez.
# ---------------------------------------------------------------------------
MEM_WORKER_INGEST=2g
MEM_WORKER_WA=512m
MEM_WORKER_AI=768m
MEM_METABASE=2g
MEM_OSRM=1g
MEM_WHISPER=3g
MEM_CLOUDFLARED=256m
# Só durante a preparação do grafo: o osrm-extract é a fase que come memória. 4g dá folga para o RN.
MEM_OSRM_PREPARO=4g

# ---------------------------------------------------------------------------
# OSRM (rota da tarde, RF-ROT-03)
# ---------------------------------------------------------------------------
# Nome do extrato, SEM extensão. O compose espera ./data/osrm/<nome>.osm.pbf para preparar
# e ./data/osrm/<nome>.osrm para rodar. O padrão é o Rio Grande do Norte inteiro (~23 MB):
#   curl -fL --create-dirs -o infra/local/data/osrm/rio-grande-do-norte-latest.osm.pbf \
#     https://download.openstreetmap.fr/extracts/south-america/brazil/northeast/rio-grande-do-norte-latest.osm.pbf
OSRM_ARQUIVO=rio-grande-do-norte-latest
# Maior matriz de tempos aceita em /table. A rota tem no máximo 6 paradas (RF-ROT-03), mas a
# seleção dos candidatos da zona consulta bem mais pontos de uma vez.
OSRM_MAX_TABLE_SIZE=200

# ---------------------------------------------------------------------------
# faster-whisper (transcrição do áudio recebido, RF-MET-07)
# ---------------------------------------------------------------------------
# tiny | base | small | medium | large-v3. "small" é o equilíbrio para pt-BR em CPU;
# "medium" acerta mais nomes próprios e pede o dobro de memória e de tempo.
WHISPER_MODEL=small
# int8 na CPU. float32 só faz sentido com GPU.
WHISPER_QUANTIZATION=int8
WHISPER_CPUS=4.0
# Quanto o healthcheck espera pela transcrição de teste, em segundos.
WHISPER_HEALTHCHECK_TIMEOUT_S=45
