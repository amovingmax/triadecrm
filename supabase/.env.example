# ============================================================================
# KOMUNE CRM — segredos da stack LOCAL do Supabase (modelo)
# Copie para `supabase/.env` (gitignored) e preencha. O Supabase CLI lê este arquivo ao avaliar os
# `env(...)` de `supabase/config.toml`; sem ele a stack sobe com um WARN e o valor fica sem substituir.
# Em produção esses valores ficam nos segredos do projeto remoto `komune-crm`, nunca no git.
# ============================================================================

# Login Google (RF-ADM-01, [auth.external.google] no config.toml): cliente OAuth "Web" criado no
# Google Cloud pelo Luiz/Matheus, com o redirect http://127.0.0.1:54321/auth/v1/callback (local).
# Com os placeholders a stack sobe normalmente, mas "Entrar com Google" não funciona até trocar.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=troque-me
SUPABASE_AUTH_GOOGLE_SECRET=troque-me
