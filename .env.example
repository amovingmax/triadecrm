# ============================================================================
# TRÍADE (CRM de captação da Komune) — variáveis de ambiente (modelo)
# Copie para `.env` na raiz e preencha. `.env` é gitignored: segredos nunca entram no git
# (em produção ficam no Vault do Supabase e no `.env` da máquina dedicada).
# Valores vazios aqui são intencionais. Quem preenche o quê: ver CLAUDE.md, "Pessoas".
#
# ONDE CADA COISA MORA
#   · Este arquivo é o ambiente da MÁQUINA DEDICADA e das ferramentas de linha de comando
#     (Supabase CLI, workers, scripts de carga). Ele NÃO é lido pela aplicação publicada.
#   · A aplicação web publicada na Vercel usa apenas as três variáveis `NEXT_PUBLIC_*` de
#     `apps/web/.env.example`, coladas no painel da Vercel. Nenhum segredo desta lista
#     (service_role, Meta, Anthropic, HMAC da Komune) deve ser cadastrado na Vercel:
#     variável de servidor na Vercel é acessível a qualquer código do projeto, e o CRM
#     não precisa de nenhuma delas para funcionar. Passo a passo: docs/operacao/publicar-na-vercel.md
#   · Os segredos das Edge Functions ficam em Supabase → Edge Functions → Secrets.
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase — projeto `komune-crm` (região São Paulo, ADR-02). Em desenvolvimento use a stack local
# (`supabase start` imprime URL e chaves: API http://127.0.0.1:54321, Postgres 127.0.0.1:54322).
# ---------------------------------------------------------------------------
# Referência do projeto remoto (só para `supabase link`; o deploy é feito pelo CI, nunca à mão).
SUPABASE_PROJECT_REF=
# URL da API (local: http://127.0.0.1:54321).
SUPABASE_URL=
# Chave anônima (pública): usada pelo navegador, sempre sob RLS.
SUPABASE_ANON_KEY=
# Chave service_role: SOMENTE em workers e Edge Functions. Ignora RLS — nunca no navegador nem em NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
# Senha do Postgres do projeto remoto (usada só pela CLI em operações autorizadas).
SUPABASE_DB_PASSWORD=
# Login Google (RF-ADM-01): cliente OAuth criado no Google Cloud; o redirect é o callback do Supabase Auth
# (local: http://127.0.0.1:54321/auth/v1/callback). Em desenvolvimento estes dois valores vão em
# `supabase/.env` (modelo em `supabase/.env.example`): é esse arquivo que o Supabase CLI lê ao avaliar os
# `env(...)` do config.toml. Aqui ficam só para o CI/produção.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# ---------------------------------------------------------------------------
# apps/web (Next.js) — o navegador só enxerga variáveis com prefixo NEXT_PUBLIC_.
# Use os mesmos valores de SUPABASE_URL e SUPABASE_ANON_KEY (nunca a service_role).
# Em desenvolvimento quem vale é `apps/web/.env.local` (modelo em apps/web/.env.example);
# em produção, as mesmas três variáveis são coladas no painel da Vercel.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL pública da aplicação, sem barra final. Local: http://localhost:3000.
# Produção: https://<seu-projeto>.vercel.app (ou o domínio próprio).
NEXT_PUBLIC_APP_URL=

# ---------------------------------------------------------------------------
# IA — D6 (ADR-10): Claude Haiku 4.5 (classificação/extração) e Claude Sonnet 5 (rascunhos, resumos, Assistente).
# Toda chamada é registrada em `ai_runs`; alerta a 80% do orçamento mensal.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Vazio = API oficial. Aponte para o dublê local (http://127.0.0.1:8787) para rodar o
# worker-ai inteiro sem credencial: node --import tsx src/ia/duble-servidor.ts
ANTHROPIC_BASE_URL=

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (Meta) — D5 (ADR-06, anexo R04). Número "Heloísa · Komune" em Coexistence. Luiz configura.
# ---------------------------------------------------------------------------
# Token de acesso do usuário de sistema (envio de mensagens pelo worker-wa).
META_WA_ACCESS_TOKEN=
# ID do número de telefone (Phone Number ID) no WhatsApp Business.
META_WA_PHONE_NUMBER_ID=
# Token de verificação do webhook (definido por nós; a Meta o envia no handshake da Edge Function wa-webhook).
META_WA_VERIFY_TOKEN=
# App Secret do app Meta: valida a assinatura X-Hub-Signature-256 dos webhooks.
META_WA_APP_SECRET=
# Base da Graph API. Vazio = a Meta de verdade (https://graph.facebook.com). Em desenvolvimento e em
# teste aponte para o dublê local, que responde como a Cloud API — inclusive com os erros dela:
#   node supabase/functions/_dubles/meta-graph-duble.mjs servir 8788
#   META_WA_GRAPH_URL=http://127.0.0.1:8788
# Não existe credencial da Meta neste repositório, e não é para existir.
META_WA_GRAPH_URL=
# Versão da Graph API. Vazio = v21.0, que é a versão contra a qual o cliente do worker foi escrito.
META_WA_API_VERSION=
# Quanto tempo um webhook da Meta continua aceitável, em segundos (padrão 86400 = 24 h). A Meta não
# manda cabeçalho de carimbo; o carimbo vem de dentro do corpo assinado (entry[].time e o timestamp
# de cada item). Janela curta demais descarta reentrega legítima — e reentrega descartada é mensagem
# de fornecedor perdida em silêncio. Vai nos Secrets da Edge Function, não no .env do worker.
WA_WEBHOOK_JANELA_SEGUNDOS=

# ---------------------------------------------------------------------------
# Rotas de visita — D9 (RF-ROT-01 e RF-ROT-03; anexo R06 §5).
#
# A coordenada dos parceiros vem do OpenStreetMap (ODbL), e não do Google: os termos da
# Google Maps Platform proíbem guardar nome, endereço e avaliação, e limitam o cache a
# `place_id`. O Google Maps continua no produto para NAVEGAR — abrir o app com um destino
# é uso de usuário final, e isso é permitido.
# ---------------------------------------------------------------------------
# OBRIGATÓRIA para `workers rotas`. A política do Nominatim exige um User-Agent que
# identifique a aplicação e dê um contato real; sem ela o worker se recusa a subir, em vez
# de mandar um UA genérico (que seria mentira, e é motivo de bloqueio).
NOMINATIM_USER_AGENT=Triade-CRM/0.1 (KOMUNE, Natal/RN; komune@komune.app.br)
# Vazio = o serviço público do OpenStreetMap, a 1 requisição por segundo (o worker
# serializa e espera sozinho). Só preencha se um dia subirmos um Nominatim próprio.
NOMINATIM_URL=
# Onde o OSRM responde. Na máquina dedicada é o nome do serviço na rede do Compose;
# em desenvolvimento, com `infra/local/docker-compose.dev.yml`, é http://127.0.0.1:5000.
OSRM_URL=http://osrm:5000

# ---------------------------------------------------------------------------
# Observabilidade — D4 (Sentry Developer, sem PII). Vazio desliga o Sentry.
# ---------------------------------------------------------------------------
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Integração com a plataforma Komune — D9 (PRD §9.5, anexo R10). Segredo compartilhado com o Matheus para
# assinar (HMAC) as chamadas à Edge Function `crm-pre-registration` e validar o webhook de status.
# ---------------------------------------------------------------------------
KOMUNE_HMAC_SECRET=

# ---------------------------------------------------------------------------
# Execução dos workers e scripts locais (opcionais; os padrões estão nos comentários).
# ---------------------------------------------------------------------------
# Nível de log dos workers: debug | info | warn | error (padrão: info).
LOG_LEVEL=
# Fuso horário de toda a lógica de janelas, cadências e digests (padrão: America/Fortaleza).
TZ=
# URL do Postgres usada por `pnpm db:seed-dev` (padrão: postgresql://postgres:postgres@127.0.0.1:54322/postgres).
DATABASE_URL=
