# apps/web — variáveis de ambiente (modelo). Copie para apps/web/.env.local (gitignored).
# O navegador enxerga tudo com prefixo NEXT_PUBLIC_: nunca coloque aqui a service_role nem outro segredo.

# URL da API do Supabase. Desenvolvimento: stack local (`supabase start` → http://127.0.0.1:54321).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Chave anônima (pública, sempre sob RLS). Local: a "anon key" impressa por `supabase status`.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL pública da aplicação (base dos redirecionamentos do login e do manifest da PWA).
NEXT_PUBLIC_APP_URL=http://localhost:3000
