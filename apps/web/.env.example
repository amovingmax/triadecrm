# =============================================================================
# apps/web (Tríade) — variáveis de ambiente (modelo)
#
# DESENVOLVIMENTO: copie este arquivo para apps/web/.env.local (gitignored) e preencha
#   com os valores impressos por `supabase status` na stack local.
# PRODUÇÃO (Vercel): NÃO existe arquivo. Estas três variáveis são coladas em
#   Vercel → Project → Settings → Environment Variables. Passo a passo completo em
#   docs/operacao/publicar-na-vercel.md.
#
# São TRÊS variáveis, todas com prefixo NEXT_PUBLIC_, ou seja: todas viajam para o
# navegador e nenhuma é segredo. O apps/web não usa, em lugar nenhum, a chave
# service_role, o token da Meta, a chave da Anthropic nem o segredo HMAC da Komune —
# esses ficam nos workers e nas Edge Functions (modelo em ../../.env.example) e NUNCA
# devem ser cadastrados no projeto da Vercel.
# =============================================================================

# URL da API do Supabase.
#   desenvolvimento: http://127.0.0.1:54321
#   produção:        https://<ref-do-projeto>.supabase.co  (projeto `komune-crm`, região São Paulo)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Chave anônima/publicável do Supabase. É pública por natureza (vai no bundle do navegador);
# quem protege o dado é a RLS no Postgres, não o sigilo desta chave.
#   desenvolvimento: a "anon key" impressa por `supabase status`
#   produção:        Supabase → Project Settings → API Keys → anon / publishable
# NUNCA use aqui a chave `service_role`/`secret`: ela ignora a RLS e vazaria para o navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública da aplicação, sem barra no final. É a base do `metadataBase` (title, manifest,
# ícones da PWA) e o destino de reserva de redirecionamentos quando a requisição chega sem host.
#   desenvolvimento: http://localhost:3000
#   produção:        https://<seu-projeto>.vercel.app  (ou o domínio próprio, quando houver)
# Se ficar em branco em produção, o app assume http://localhost:3000 e o manifest da PWA
# passa a apontar para a máquina de quem abriu — a instalação no celular quebra.
NEXT_PUBLIC_APP_URL=http://localhost:3000
