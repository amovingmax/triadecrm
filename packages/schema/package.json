{
  "name": "@komune/schema",
  "version": "0.1.0",
  "private": true,
  "description": "Schemas zod e tipos gerados do banco (Supabase), compartilhados por apps/web, apps/workers e Edge Functions.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./normalizadores": {
      "types": "./src/normalizadores.ts",
      "default": "./src/normalizadores.ts"
    },
    "./schemas": {
      "types": "./src/schemas.ts",
      "default": "./src/schemas.ts"
    },
    "./database.types": {
      "types": "./src/database.types.ts",
      "default": "./src/database.types.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
